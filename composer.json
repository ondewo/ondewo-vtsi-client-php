{
  "name": "ondewo/vtsi-client-php",
  "description": "ONDEWO VTSI (Virtual Telephony Server Interface) gRPC client for PHP, generated from the ondewo-vtsi-api protocol buffer definitions",
  "type": "library",
  "keywords": [
    "ondewo",
    "vtsi",
    "grpc",
    "protobuf",
    "client"
  ],
  "homepage": "https://github.com/ondewo/ondewo-vtsi-client-php",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "ONDEWO GmbH",
      "email": "office@ondewo.com",
      "homepage": "https://www.ondewo.com"
    }
  ],
  "support": {
    "issues": "https://github.com/ondewo/ondewo-vtsi-client-php/issues",
    "source": "https://github.com/ondewo/ondewo-vtsi-client-php"
  },
  "require": {
    "ext-grpc": "*",
    "google/protobuf": "5.35.1",
    "grpc/grpc": "1.85.0",
    "php": ">=8.2.0"
  },
  "suggest": {
    "psr/log": "To receive ClientConfig's insecure-channel warning on a PSR-3 logger instead of error_log()"
  },
  "autoload": {
    "classmap": [
      "auth/",
      "src/"
    ],
    "psr-4": {
      "Ondewo\\Vtsi\\Auth\\": "auth/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Ondewo\\Vtsi\\Tests\\": "tests/"
    }
  },
  "version": "9.5.2"
}
